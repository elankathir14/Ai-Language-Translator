# ==============================================================================
# AI Language Translator - Environment Configuration
# CodeAlpha Artificial Intelligence Internship Project
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=your_secret_key_here_generate_with_os_urandom

# Translation Provider Selection
# Options: "google" (default, free engine with fallback), "mymemory", "gemini"
TRANSLATION_PROVIDER=google

# Provider API Credentials (Optional - Defaults work out of the box)
# Google Cloud Translation API Key (leave empty to use default Google engine)
GOOGLE_TRANSLATE_API_KEY=

# MyMemory API Key / Email (increases free daily limit from 5,000 to 50,000 words)
MYMEMORY_API_KEY=
MYMEMORY_EMAIL=

# Google Gemini API Key (optional - enable by setting TRANSLATION_PROVIDER=gemini)
GEMINI_API_KEY=
